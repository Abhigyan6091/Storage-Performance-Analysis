; CS559 System Design - FIO Benchmark Configuration
; Workload: Case_A (Point_Lookups_Index_Access)
; Queue Depth: 1
; Purpose: PostgreSQL B-Tree index lookup / single row point queries

[global]
ioengine=libaio
direct=1
size=1g
runtime=20
time_based=1
ramp_time=3
group_reporting=1
filename=/root/fio-lab/db-test.bin
percentile_list=50:95:99

[Case_A_qd1]
rw=randread
bs=4k
iodepth=1
numjobs=1

; CS559 System Design - Case_B Full Suite
; Workload: Read_Heavy_OLTP_Transactional
; Access pattern: rw=randrw, bs=4k, rwmixread=70%

[global]
ioengine=libaio
direct=1
size=1g
runtime=20
time_based=1
ramp_time=3
group_reporting=1
filename=/root/fio-lab/db-test.bin
percentile_list=50:95:99
numjobs=1

[Case_B_qd1]
rw=randrw
bs=4k
rwmixread=70
iodepth=1

[Case_B_qd8]
rw=randrw
bs=4k
rwmixread=70
iodepth=8

[Case_B_qd32]
rw=randrw
bs=4k
rwmixread=70
iodepth=32


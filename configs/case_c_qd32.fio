; CS559 System Design - FIO Benchmark Configuration
; Workload: Case_C (Write_Heavy_Checkpoint_Batch)
; Queue Depth: 32
; Purpose: PostgreSQL write-heavy checkpointer page flush / batch update (30% read / 70% write, 8KB native page)

[global]
ioengine=libaio
direct=1
size=1g
runtime=20
time_based=1
ramp_time=3
group_reporting=1
filename=/root/fio-lab/db-test.bin
percentile_list=50:95:99

[Case_C_qd32]
rw=randrw
bs=8k
rwmixread=30
iodepth=32
numjobs=1

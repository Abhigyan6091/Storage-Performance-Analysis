; CS559 System Design - Case_A Full Suite
; Workload: Point_Lookups_Index_Access
; Access pattern: rw=randread, bs=4k, rwmixread=100%

[global]
ioengine=libaio
direct=1
size=1g
runtime=20
time_based=1
ramp_time=3
group_reporting=1
filename=/root/fio-lab/db-test.bin
percentile_list=50:95:99
numjobs=1

[Case_A_qd1]
rw=randread
bs=4k
iodepth=1

[Case_A_qd8]
rw=randread
bs=4k
iodepth=8

[Case_A_qd32]
rw=randread
bs=4k
iodepth=32

